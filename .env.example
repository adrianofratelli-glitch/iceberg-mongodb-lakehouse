# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env preenchido.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.xxxxx.mongodb.net/
DATABASE_NAME=iceberg_demo
COLLECTION_NAME=orders

# AWS (usadas pelo setup/aws/bootstrap.sh, não pelo config.py)
AWS_REGION=us-east-1
S3_BUCKET=<seu-bucket>
GLUE_DATABASE=mongodb_iceberg_demo

# Opcional: habilita GET /api/lag (backend/lag_side.py), que mede a distância
# entre o checkpoint do stream processor e a janela do oplog. Sem isso o
# endpoint responde "disponivel: false" em vez de falhar.
STREAM_PROCESSING_URI=
PROCESSOR_NAME=ordersToIceberg
MONGOSH_PATH=mongosh
